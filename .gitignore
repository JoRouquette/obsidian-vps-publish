/node_modules
/dist
/apps/node/src/infra/filesystem/dist/
/libs/core-application/src/lib/_tests/publishing/dist/

# Sortie de compilation émise à côté des sources.
# 438 fichiers (.js, .d.ts, .d.ts.map) avaient fini versionnés sous libs/*/src,
# puis recopiés dans le miroir scanné par la revue du répertoire Obsidian.
# La cause a été corrigée (outDir/rootDir dans libs/core-application/tsconfig.lib.json) ;
# ces motifs sont le filet, pour qu'un `tsc -p` égaré ne les ramène pas.
# Les .d.ts ÉCRITS À LA MAIN vivent sous apps/*/src/types/ et ne sont pas concernés.
/libs/*/src/**/*.js
/libs/*/src/**/*.d.ts
/libs/*/src/**/*.d.ts.map
/libs/*/src/**/*.js.map
*.tsbuildinfo
/.idea
.env
.env.**
!.env.**example
/tmp
diff.md
report.json
report.html

# Lighthouse CI reports
.lighthouseci/

# Playwright reports
**/playwright-report/
**/test-results/

# Load test reports
/tools/load-tests/artillery/reports/**/*
!/tools/load-tests/artillery/reports/.gitkeep

/docs/references/**/* 

# Ignore node_modules, dist, and .env in all apps
/apps/*/node_modules
/apps/*/dist
/apps/*/.env
/apps/*/tmp
apps/*/.env
apps/*/.env.*
!apps/*/.env.example

# Ignore build artifacts in the ui app
coverage/**/*
**/content/**/*
!apps/site/e2e/fixtures/content/**/*
**/assets/**/*
!apps/site/e2e/fixtures/assets/**/*
!apps/node/src/assets/
!apps/node/src/assets/publication-trace-bench/
!apps/node/src/assets/publication-trace-bench/callouts/
!apps/node/src/assets/publication-trace-bench/fixtures/
!apps/node/src/assets/publication-trace-bench/**/*
**/build/**/*
**.angular**
**.next**
**.turbo**
**.cache**
**.output**

# Ignore logs
logs
*.log
npm-debug.log*

./obsidian-vps-publish/

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
.angular

# Vestige : le coffre de recette n'est plus dans le dépôt. Avec le développement
# en worktrees, un coffre par arborescence signifierait un data.json par branche.
# Il est désormais externe, désigné par OBSIDIAN_TEST_VAULT
# (cf. apps/obsidian-vps-publish/scripts/deploy-to-vault.mjs).
# Conservé pour ignorer les reliquats dans les worktrees existantes.
test-vault

# Claude Code configuration
.claude/
